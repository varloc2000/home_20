# ==========================================
# Secret Files & Credentials (CRITICAL)
# ==========================================
.env
*.pem
*.crt
*.key
homeassistant/config/secrets.yaml
zigbee2mqtt/data/secret.yaml
mosquitto/config/passwd
mosquitto/config/pwfile

# ==========================================
# Home Assistant Runtime & Storage
# ==========================================
homeassistant/config/.storage/
homeassistant/config/.cache/
homeassistant/config/*.db
homeassistant/config/*.db-wal
homeassistant/config/*.db-shm
homeassistant/config/*.log
homeassistant/config/*.log.*
homeassistant/config/tts/
homeassistant/config/deps/
homeassistant/config/blueprints/
homeassistant/config/.HA_RESTORE_STATE
homeassistant/config/.HA_PERSISTENT_NOTIFICATION

# ==========================================
# Mosquitto Broker Data
# ==========================================
mosquitto/data/
mosquitto/log/

# ==========================================
# Zigbee2MQTT Runtime Data
# ==========================================
zigbee2mqtt/data/database.db
zigbee2mqtt/data/state.json
zigbee2mqtt/data/log/
zigbee2mqtt/data/*.db
zigbee2mqtt/data/*.db-wal
zigbee2mqtt/data/*.db-shm

# ==========================================
# System & IDE Junk
# ==========================================
.DS_Store
Thumbs.db
*.swp
*.tmp
.vscode/
.idea/